{
  "name": "Мазок — цифровое рисование",
  "short_name": "Мазок",
  "description": "Рисование кистями со слоями, выделением, трансформацией, коррекцией, анимацией и таймлапсом. Работает без интернета.",
  "lang": "ru",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#141518",
  "theme_color": "#141518",
  "categories": ["graphics", "productivity", "art"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "image/png": [".png"], "image/jpeg": [".jpg", ".jpeg"], "image/vnd.adobe.photoshop": [".psd"], "application/x-mazok": [".mazok"] } }
  ]
}
